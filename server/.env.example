# Copy to .env and adjust. No secrets or API keys are needed.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/video-sharing
# Only if a mongodb+srv:// (Atlas) URI fails with "querySrv ECONNREFUSED":
# DNS_SERVERS=8.8.8.8,1.1.1.1
CLIENT_URL=http://localhost:5173
# Upload size cap in MB. 0 = no limit.
MAX_VIDEO_SIZE_MB=0
# Refuse uploads that would leave less free disk space than this (MB).
MIN_FREE_DISK_MB=1024
MAX_CONCURRENT_STREAMS=20
# Max bytes per range response in MB. 0 = no cap (needed by old TV video players).
STREAM_CHUNK_SIZE_MB=0
# Convert uploads TV browsers cannot play (MKV, AVI, AC3/DTS audio, HEVC...) to H.264/AAC MP4.
# Uses the ffmpeg bundled via npm; set FFMPEG_PATH / FFPROBE_PATH to use your own.
TRANSCODE_ENABLED=true
